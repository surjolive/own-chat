{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "baseUrl": ".",
    "paths": {
      "@surjo/shared": ["./packages/shared/src/index.ts"],
      "@surjo/security": ["./packages/security/src/index.ts"],
      "@surjo/database": ["./packages/database/src/index.ts"],
      "@surjo/whatsapp-engine": ["./packages/whatsapp-engine/src/index.ts"]
    }
  }
}
